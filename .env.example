# PostgreSQL
POSTGRES_USER=turfmanagement_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=turfmanagement

# JWT secrets (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production

# Frontend URL (used for payment redirects and CORS)
FRONTEND_URL=https://app.turfcarebd.com

# SSLCommerz payment gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# bKash payment gateway (tokenized checkout)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_SANDBOX=true

# Nagad payment gateway
NAGAD_MERCHANT_ID=
NAGAD_SECRET_KEY=
NAGAD_SANDBOX=true

# SendGrid email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@turfcarebd.com

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
