NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
FRONTEND_URL=https://turfmanage.vercel.app
LOG_LEVEL=info
UPLOAD_DIR=./uploads

# Rate limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000

# SSLCommerz (sandbox by default; set SSLCOMMERZ_IS_LIVE=true for production)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# SendGrid (email notifications; falls back to console logging when empty)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@turfcarebd.com

# Integration tests (isolated PostgreSQL database)
TEST_DATABASE_URL=
TEST_JWT_SECRET=test-jwt-secret
