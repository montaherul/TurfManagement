generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logo            String?
  address         Json?
  primaryContact  Json?
  subscription    Json?
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users          User[]
  fields         Field[]
  inspections    Inspection[]
  workOrders     WorkOrder[]
  subscriptionDb Subscription?
  auditLogs      AuditLog[]
  rolePermissions RolePermission[]
  payments       Payment[]
  notifications  Notification[]
  scheduledReports ScheduledReport[]
}

model User {
  id                      String   @id @default(cuid())
  organizationId          String?
  email                   String   @unique
  passwordHash            String
  firstName               String
  lastName                String
  role                    String
  isActive                Boolean  @default(true)
  lastLoginAt             DateTime?
  profilePhoto            String?
  notificationPreferences Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization          Organization?  @relation(fields: [organizationId], references: [id])
  inspections          Inspection[]   @relation("Inspector")
  verifiedInspections  Inspection[]   @relation("VerifiedBy")
  assignedWorkOrders   WorkOrder[]    @relation("Assignee")
  auditLogs            AuditLog[]
  userPermissions      UserPermission[]
  notifications        Notification[]

  @@index([organizationId, role])
  @@index([organizationId, isActive])
}

model RolePermission {
  id             String       @id @default(cuid())
  role           String
  action         String
  organizationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, role, action])
  @@index([role, action])
  @@index([organizationId, role])
}

model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  action    String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, action])
  @@index([userId])
}

model Field {
  id             String   @id @default(cuid())
  organizationId String
  fieldId        String
  name           String
  sportType      String
  location       Json?
  address        Json?
  dimensions     Json?
  turfType       String?
  grassSpecies   String?
  drainageType   String?
  gpsCoordinates Json?
  photos         Json?
  status         String   @default("active")
  metadata       Json?
  currentScore   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  inspections  Inspection[]
  workOrders   WorkOrder[]

  @@unique([organizationId, fieldId])
  @@index([organizationId, sportType])
}

model Inspection {
  id              String   @id @default(cuid())
  organizationId  String
  fieldId         String
  inspectorId     String
  inspectionDate  DateTime
  weatherConditions Json?
  surfaceAssessment Json?
  soilAssessment    Json?
  structuralAssessment Json?
  grassHealth       Json?
  photographs       Json?
  pitchQualityScore Json?
  recommendations  Json?
  status           String   @default("draft")
  verifiedBy       String?
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  field        Field         @relation(fields: [fieldId], references: [id])
  inspector    User          @relation("Inspector", fields: [inspectorId], references: [id])
  verifier     User?         @relation("VerifiedBy", fields: [verifiedBy], references: [id])
  workOrders   WorkOrder[]

  @@index([organizationId, fieldId, inspectionDate(sort: Desc)])
  @@index([organizationId, inspectorId, createdAt(sort: Desc)])
  @@index([organizationId, status])
}

model WorkOrder {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String   @unique
  fieldId        String
  inspectionId   String?
  title          String
  description    String?
  tasks          Json?
  priority       String
  status         String   @default("created")
  assignedTo     String?
  dueDate        DateTime?
  completedDate  DateTime?
  estimatedCost  Json?
  actualCost     Json?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  field        Field        @relation(fields: [fieldId], references: [id])
  inspection   Inspection?  @relation(fields: [inspectionId], references: [id])
  assignee     User?        @relation("Assignee", fields: [assignedTo], references: [id])

  @@index([organizationId, status, priority])
  @@index([organizationId, fieldId, dueDate])
}

model Subscription {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  planId              String
  status              String   @default("active")
  billingModel        String   @default("subscription")
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  inspectionsUsed     Int      @default(0)
  inspectionsLimit    Int?
  amountBDT           Int      @default(0)
  currency            String   @default("BDT")
  paymentMethod       Json?
  nextBillingDate     DateTime?
  gracePeriodEnd      DateTime?
  canceledAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([status, nextBillingDate])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resource       String
  resourceId     String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  invoiceNo      String   @unique
  tranId         String   @unique
  valId          String?
  planId         String
  planName       String
  amountBDT      Int
  currency       String   @default("BDT")
  status         String   @default("pending")
  paymentMethod  Json?
  billToName     String?
  billToEmail    String?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String?
  userId         String
  event          String
  title          String
  message        String?
  payload        Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([organizationId, createdAt(sort: Desc)])
}

model ScheduledReport {
  id             String    @id @default(cuid())
  organizationId String
  frequency      String
  recipients     Json
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([enabled, lastRunAt])
}