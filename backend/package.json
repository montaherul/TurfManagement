{
    "name":  "turfcare-bd-backend",
    "version":  "1.0.0",
    "description":  "TurfCare BD - Enterprise Turf Management API",
    "main":  "src/server.js",
    "type":  "module",
"scripts": {
  "dev": "nodemon src/server.js",
  "start": "node src/server.js",
  "lint": "eslint src --ext .js",
  "test": "jest --coverage",
  "build": "prisma generate",
  "postinstall": "prisma generate",
  "db:migrate": "prisma migrate deploy",
  "db:dev": "prisma migrate dev",
  "db:seed": "node scripts/seed.js",
  "db:procedures": "node scripts/install_procedures.mjs",
  "db:studio": "prisma studio"
},
    "jest":  {
                 "testEnvironment":  "node",
                 "testMatch":  [
                                   "**/tests/**/*.test.js"
                               ],
                 "coveragePathIgnorePatterns":  [
                                                    "/node_modules/"
                                                ],
                 "setupFiles":  [
                                    "\u003crootDir\u003e/tests/setupEnv.cjs"
                                ]
             },
"dependencies": {
  "@prisma/client": "^6.19.3",
  "@sendgrid/mail": "^7.7.0",
  "bcryptjs": "^2.4.3",
  "bullmq": "^4.15.1",
  "compression": "^1.7.4",
  "cookie-parser": "^1.4.6",
  "cors": "^2.8.5",
  "crypto": "^1.0.1",
  "dotenv": "^16.3.1",
  "express": "^4.18.2",
  "express-mongo-sanitize": "^2.2.0",
  "express-rate-limit": "^7.1.5",
  "helmet": "^7.1.0",
  "hpp": "^0.2.3",
  "ioredis": "^5.3.2",
  "joi": "^17.11.0",
  "jsonwebtoken": "^9.0.2",
  "moment": "^2.29.4",
  "mongoose": "^8.0.0",
  "morgan": "^1.10.0",
  "multer": "^1.4.5-lts.1",
  "pdfmake": "^0.2.7",
  "pg": "^8.23.0",
  "redis": "^4.6.10",
  "sharp": "^0.32.6",
  "socket.io": "^4.7.2",
  "sslcommerz-lts": "^1.2.0",
  "stripe": "^14.9.0",
  "winston": "^3.11.0",
  "zod": "^3.22.4"
},
"devDependencies": {
  "@babel/preset-env": "^8.0.2",
  "eslint": "^8.54.0",
  "jest": "^29.7.0",
  "nodemon": "^3.0.1",
  "prisma": "^6.19.3",
  "supertest": "^6.3.3"
}
}
